# Server only — never expose to the browser (no VITE_ prefix)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_AUTH_JWKS_URL=https://ep-XXXX.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_URL=https://ep-XXXX.neonauth.REGION.aws.neon.tech/neondb/auth
API_PORT=3001
APP_ORIGIN=https://www.sistemascuesta.com.br

# Browser-safe (usadas no build do Vite)
VITE_NEON_AUTH_URL=https://ep-XXXX.neonauth.REGION.aws.neon.tech/neondb/auth
VITE_API_URL=

# Google Places API (New) — telefones de CFTV/eletricista/segurança (somente servidor)
GOOGLE_PLACES_API_KEY=
