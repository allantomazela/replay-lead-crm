  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "start": "pnpm dev",
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env-dev server/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "start:prod": "tsx --env-file=.env-prod server/index.ts",
    "lint": "oxlint src server",
    "lint:fix": "oxlint src server --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "echo \"there are no tests for this project\" && exit 0",
    "test:watch": "echo \"there are no tests for this project\" && exit 0"
